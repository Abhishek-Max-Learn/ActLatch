{
  "name": "actlatch",
  "version": "0.1.0",
  "description": "Act-Latch: an MCP gateway that checks every AI agent tool call against a policy before it happens.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts start",
    "demo": "tsx examples/demo.ts",
    "demo:agents": "tsx examples/agents-demo.ts",
    "registry": "tsx src/cli.ts registry --config examples/agents.yaml",
    "setup": "tsx src/cli.ts setup --config examples/servers.yaml --out examples/my-actlatch.yaml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishek-Max-Learn/actlatch.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Abhishek-Max-Learn/actlatch/issues"
  },
  "homepage": "https://github.com/Abhishek-Max-Learn/actlatch#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "bin": {
    "actlatch": "dist/src/cli.js"
  }
}
